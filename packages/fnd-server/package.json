    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "loglevel": "^1.9.2",
    "morgan": "^1.12.1"
  },
  "devDependencies": {
    "@toruslabs/config": "^5.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/morgan": "^1.9.10",
    "@types/node": "^24.19.2",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
