{
  "name": "fnd",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/constants",
    "packages/fnd-base",
    "packages/fetch-node-details",
    "packages/fnd-server"
  ],
  "devDependencies": {
    "@toruslabs/config": "^4.0.0",
    "@toruslabs/oxlint-config-node": "^1.0.0",
    "@toruslabs/oxlint-config-typescript": "^1.1.0",
    "@toruslabs/torus-scripts": "^9.0.1",
    "rimraf": "^6.1.3",
    "typescript": "^5.9.3",
    "vite-plus": "1.5.0",
    "wait-port": "^1.1.0"
  },
  "version": "1.1.0",
  "main": "index.js",
  "scripts": {
    "wait": "wait-port 8060",
    "test": "npm run test --workspaces --if-present",
    "server:dev": "docker compose -f docker-compose.dev.yml up --build",
    "server:detach": "docker compose -f docker-compose.dev.yml up --build --detach",
    "test:ci": "npm run server:detach && wait-port 8060 && sleep 20 && npm run test",
    "build": "npm run build --workspaces --if-present",
    "lint": "vp lint",
    "dev": "npm run dev -w @toruslabs/fnd-server",
    "clean": "rimraf --glob \"packages/*/dist\"",
    "format": "vp fmt",
    "format:check": "vp fmt --check",
    "check": "vp check",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=24.22.0",
    "npm": ">=12"
  },
  "author": "",
  "license": "MIT",
  "description": "",
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vitest": "5.1.0"
  }
}
