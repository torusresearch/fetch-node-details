## Avoid installing packages published in last 3 days.
min-release-age=3

## @toruslabs/loglevel-sentry@10 (2026-11-05) is the release that typechecks against Sentry 11.
min-release-age-exclude[]=@toruslabs/loglevel-sentry

## Don't install packages from git urls.
allow-git=none

## Disable installing dependencies from remote URLs.
allow-remote=none

## Pin allowed scripts to exact versions of dependencies to prevent unexpected script execution.
allow-scripts-pin=true
